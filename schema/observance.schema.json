{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandhyakatha.app/schema/observance-1.1.json",
  "title": "Sandhya Katha — Bharat Observance",
  "description": "One sourced cultural/religious observance definition. This defines what is observed and under which documented rule; it does not imply that Sandhya Katha has a story for it.",
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "status",
    "names",
    "kind",
    "subjects",
    "scope",
    "rule",
    "importance",
    "confidence",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable canonical slug. Never encode a Gregorian year in the id."
    },
    "schemaVersion": {
      "const": "1.1"
    },
    "status": {
      "enum": [
        "discovered",
        "sourced",
        "in-review",
        "approved",
        "retired"
      ],
      "description": "approved is the only status eligible for production observance resolution."
    },
    "names": {
      "type": "object",
      "required": [
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "ta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "sa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "breadth",
        "traditions",
        "regions"
      ],
      "additionalProperties": false,
      "properties": {
        "breadth": {
          "enum": [
            "pan-india",
            "broad",
            "regional",
            "sampradaya",
            "temple-specific"
          ]
        },
        "traditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "note": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "lunar-tithi",
            "lunar-nakshatra",
            "solar-nakshatra",
            "solar-day",
            "recurring-tithi",
            "multi-day",
            "relative",
            "gregorian-fixed",
            "yearly-explicit",
            "solar-month-lunar-tithi"
          ]
        },
        "monthSystem": {
          "enum": [
            "amanta",
            "purnimanta",
            "solar",
            "not-applicable",
            "sourced-variant"
          ]
        },
        "month": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "paksha": {
          "enum": [
            "shukla",
            "krishna"
          ]
        },
        "tithi": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "nakshatra": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "solarCalendar": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "solarDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "weekday": {
          "enum": [
            "monday",
            "tuesday",
            "wednesday",
            "thursday",
            "friday",
            "saturday",
            "sunday"
          ]
        },
        "decisionWindow": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "anchorObservanceId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "offsetDays": {
          "type": "integer",
          "minimum": -40,
          "maximum": 40
        },
        "durationDays": {
          "type": "integer",
          "minimum": 2,
          "maximum": 45
        },
        "gregorianMonth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "gregorianDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "datesByYear": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[0-9]{4}$": {
              "type": "string",
              "format": "date"
            }
          },
          "additionalProperties": false
        },
        "adhikaPolicy": {
          "enum": [
            "observe",
            "skip",
            "tradition-specific",
            "not-applicable"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 800
        },
        "solarMonth": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      }
    },
    "importance": {
      "type": "object",
      "required": [
        "tier",
        "score"
      ],
      "additionalProperties": false,
      "properties": {
        "tier": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "note": {
          "type": "string",
          "maxLength": 400
        }
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "provisional"
      ]
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "scope",
          "difference"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "scope": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "difference": {
            "type": "string",
            "minLength": 5,
            "maxLength": 800
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "authority",
              "citation",
              "supports"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "type": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "authority": {
                "type": "string",
                "minLength": 2,
                "maxLength": 200
              },
              "citation": {
                "type": "string",
                "minLength": 3,
                "maxLength": 500
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "accessedOn": {
                "type": "string",
                "format": "date"
              },
              "supports": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "identity",
                    "names",
                    "kind",
                    "subjects",
                    "scope",
                    "rule",
                    "importance",
                    "variant"
                  ]
                }
              },
              "note": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "reviewedOn": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "editorialNote": {
      "type": "string",
      "maxLength": 1000
    }
  }
}
